{
    "global_settings": {
        "description": "全局设置",
        "type": "object",
        "items": {
            "default_openlist_url": {
                "description": "默认Openlist服务器地址",
                "type": "string",
                "default": "",
                "hint": "http://localhost:5244"
            },
            "public_openlist_url": {
                "description": "Openlist公网服务地址 (可选)",
                "type": "string",
                "default": "",
                "hint": "当默认地址是内网地址时，可用于构建公网下载链接"
            },
            "default_username": {
                "description": "默认用户名",
                "type": "string",
                "default": "",
                "hint": "留空表示匿名访问"
            },
            "default_password": {
                "description": "默认密码",
                "type": "string",
                "default": "",
                "hint": "用户名为空时可忽略"
            },
            "default_token": {
                "description": "默认访问Token",
                "type": "string",
                "default": "",
                "hint": "可选，优先级高于用户名密码"
            },
            "fixed_base_directory": {
                "description": "下载/真实链接前缀路径",
                "type": "string",
                "default": "",
                "hint": "用于 /d、/p 和 /api/fs/link 等真实下载路径。例如: /夸克；留空则不添加前缀。"
            },
            "max_display_files": {
                "description": "最大显示文件数",
                "type": "int",
                "default": 20,
                "slider": {
                    "min": 1,
                    "max": 100,
                    "step": 1
                }
            },
            "allowed_extensions": {
                "description": "允许的文件扩展名",
                "type": "text",
                "default": "",
                "hint": "用逗号分隔，如: .txt,.pdf,.jpg。留空表示不限制；设置后会限制下载、取链接、预览和上传。"
            },
            "max_preview_size": {
                "description": "最大预览文件大小(MB)",
                "type": "int",
                "default": 10
            },
            "text_preview_length": {
                "description": "文本文件预览长度",
                "type": "int",
                "slider": {
                    "min": 100,
                    "max": 4000,
                    "step": 100
                },
                "default": 1000
            },
            "enable_cache": {
                "description": "启用文件列表缓存",
                "type": "bool",
                "default": true
            },
            "cache_duration": {
                "description": "缓存有效期(秒)",
                "type": "int",
                "default": 300,
                "minimum": 60,
                "maximum": 3600
            },
            "max_download_size": {
                "description": "最大下载文件大小(MB)",
                "type": "int",
                "slider": {
                    "min": 0,
                    "max": 500,
                    "step": 1
                },
                "default": 50,
                "hint": "0 表示不限制。"
            },
            "max_upload_size": {
                "description": "最大上传文件大小(MB)",
                "type": "int",
                "slider": {
                    "min": 0,
                    "max": 10240,
                    "step": 1
                },
                "default": 100,
                "hint": "0 表示不限制。"
            },
            "upload_mode_timeout": {
                "description": "上传模式持续时间(分钟)",
                "type": "int",
                "slider": {
                    "min": 1,
                    "max": 1440,
                    "step": 1
                },
                "default": 10,
                "hint": "开启上传模式后，超过该时间未完成上传会自动取消。"
            },
            "upload_chunk_size_mb": {
                "description": "上传分块大小(MB)",
                "type": "int",
                "default": 4,
                "hint": "本地/URL中转上传时每次读取的块大小。"
            },
            "upload_progress_step_mb": {
                "description": "上传进度日志间隔(MB)",
                "type": "int",
                "default": 64,
                "hint": "仅 debug_transfer_logging 开启时生效。"
            },
            "upstream_connect_timeout": {
                "description": "上游URL连接超时(秒)",
                "type": "int",
                "default": 60
            },
            "upstream_read_timeout": {
                "description": "上游URL无数据超时(秒)",
                "type": "int",
                "default": 180
            },
            "openlist_connect_timeout": {
                "description": "OpenList上传连接超时(秒)",
                "type": "int",
                "default": 30
            },
            "openlist_upload_response_timeout": {
                "description": "OpenList上传响应超时(秒)",
                "type": "int",
                "default": 3000
            },
            "debug_transfer_logging": {
                "description": "启用传输诊断日志",
                "type": "bool",
                "default": false,
                "hint": "开启后输出上传/下载进度、连接信息和 DNS 解析等详细日志。"
            },
            "require_user_auth": {
                "description": "要求用户认证",
                "type": "bool",
                "default": true,
                "hint": "启用后每个用户需要独立配置"
            },
            "backup_default_path": {
                "description": "手动备份默认目录",
                "type": "string",
                "default": "/backup/group_{group_id}",
                "hint": "使用 /ol backup 且未指定路径时的 OpenList 目录。支持 {group_id}、{gid}、{group} 占位符。"
            },
            "autobackup_default_path": {
                "description": "自动备份默认目录",
                "type": "string",
                "default": "/backup/group_{group_id}",
                "hint": "自动备份群配置未指定路径，或 /ol autobackup enable 未传路径时使用。支持 {group_id}、{gid}、{group} 占位符。"
            },
            "autobackup_groups": {
                "description": "启用自动备份的群组",
                "type": "list",
                "default": [],
                "hint": "启用自动备份的群号列表。格式支持：'群号' 或 '群号:/路径'。未指定路径则使用自动备份默认目录。"
            },
            "backup_allowed_extensions": {
                "description": "备份允许的文件扩展名",
                "type": "text",
                "default": "",
                "hint": "用逗号分隔，如: .txt,.pdf。留空表示不限制。"
            },
            "backup_max_size": {
                "description": "备份单个文件大小上限(MB)",
                "type": "int",
                "default": 0,
                "hint": "0 表示不限制。"
            }
        }
    }
} 
