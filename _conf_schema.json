{
    "connection": {
        "type": "object",
        "description": "服务器连接",
        "hint": "配置 OpenList 服务器地址与认证信息。",
        "items": {
            "default_openlist_url": {
                "description": "OpenList 地址",
                "type": "string",
                "default": "",
                "hint": "例如 http://localhost:5244 。"
            },
            "public_openlist_url": {
                "description": "公网地址",
                "type": "string",
                "default": "",
                "hint": "可选，当默认地址是内网地址时，用于生成外部可访问的下载链接。"
            },
            "default_username": {
                "description": "登录用户名",
                "type": "string",
                "default": "",
                "hint": "留空表示匿名访问。"
            },
            "default_password": {
                "description": "登录密码",
                "type": "string",
                "default": "",
                "hint": "用户名不为空时必填。"
            },
            "fixed_base_directory": {
                "description": "下载路径前缀",
                "type": "string",
                "default": "",
                "hint": "用于补齐实际根路径前缀，适用于如当前用户根目录与 OpenList 实际根目录不一致的场景；留空则不添加前缀。"
            }
        }
    },
    "display": {
        "type": "object",
        "description": "显示与预览",
        "hint": "控制文件列表显示与预览行为。",
        "items": {
            "max_display_files": {
                "description": "最大显示文件数",
                "type": "int",
                "default": 20,
                "minimum": 1,
                "maximum": 100,
                "slider": {
                    "min": 1,
                    "max": 100,
                    "step": 1
                },
                "hint": "每页列表显示的最大文件数。"
            },
            "max_preview_size": {
                "description": "最大预览文件大小（MB）",
                "type": "int",
                "default": 10,
                "minimum": 1,
                "maximum": 500,
                "slider": {
                    "min": 1,
                    "max": 500,
                    "step": 1
                },
                "hint": "超过此大小的文件不会进行内容预览。"
            },
            "text_preview_length": {
                "description": "文本文件预览长度（字符）",
                "type": "int",
                "default": 1000,
                "minimum": 100,
                "maximum": 4000,
                "slider": {
                    "min": 100,
                    "max": 4000,
                    "step": 100
                },
                "hint": "预览文本文件时最多显示的字符数。"
            }
        }
    },
    "cache": {
        "type": "object",
        "description": "缓存",
        "hint": "控制文件列表缓存的开关与有效期。",
        "items": {
            "enable_cache": {
                "description": "启用文件列表缓存",
                "type": "bool",
                "default": true,
                "hint": "开启后文件列表结果会被缓存，减少重复请求。"
            },
            "cache_duration": {
                "description": "缓存有效期（秒）",
                "type": "int",
                "default": 300,
                "minimum": 60,
                "maximum": 3600,
                "hint": "缓存过期后自动刷新。"
            }
        }
    },
    "transfer": {
        "type": "object",
        "description": "文件传输",
        "hint": "上传与下载的大小限制、分块参数及扩展名过滤。",
        "items": {
            "max_upload_size": {
                "description": "最大上传文件大小（MB）",
                "type": "int",
                "default": 100,
                "minimum": 0,
                "maximum": 10240,
                "slider": {
                    "min": 0,
                    "max": 10240,
                    "step": 1
                },
                "hint": "0 表示不限制。"
            },
            "max_download_size": {
                "description": "最大下载文件大小（MB）",
                "type": "int",
                "default": 50,
                "minimum": 0,
                "maximum": 500,
                "slider": {
                    "min": 0,
                    "max": 500,
                    "step": 1
                },
                "hint": "0 表示不限制。"
            },
            "upload_chunk_size_mb": {
                "description": "上传分块大小（MB）",
                "type": "int",
                "default": 4,
                "minimum": 1,
                "maximum": 64,
                "hint": "上传文件时每次读取的块大小，越大则内存占用越高。"
            },
            "allowed_extensions": {
                "description": "允许的文件扩展名",
                "type": "text",
                "default": "",
                "hint": "用逗号分隔，如：txt,pdf,jpg。留空表示不限制；设置后会限制上传和下载（取链接、恢复）。显示和预览不受此限制影响。"
            }
        }
    },
    "backup": {
        "type": "object",
        "description": "群文件备份",
        "hint": "备份路径与过滤配置。",
        "items": {
            "backup_default_path": {
                "description": "备份默认目录",
                "type": "string",
                "default": "/backup/group_{group_id}",
                "hint": "使用 /ol backup 且未指定路径时的 OpenList 目录。支持 {group_id} 占位符。"
            },
            "autobackup_groups": {
                "description": "启用自动备份的群组",
                "type": "list",
                "default": [],
                "hint": "启用自动备份的群号列表。格式支持：「群号」或「群号:/路径」。未指定路径则使用备份默认目录。"
            },
            "backup_allowed_extensions": {
                "description": "备份允许的文件扩展名",
                "type": "text",
                "default": "",
                "hint": "用逗号分隔，如：txt,pdf。留空表示不限制。"
            },
            "backup_max_size": {
                "description": "备份文件大小上限（MB）",
                "type": "int",
                "default": 0,
                "minimum": 0,
                "maximum": 10240,
                "slider": {
                    "min": 0,
                    "max": 10240,
                    "step": 1
                },
                "hint": "0 表示不限制。"
            },
            "backup_skip_existing": {
                "description": "跳过已存在备份文件",
                "type": "bool",
                "default": true,
                "hint": "开启后，目标目录已有同名且大小一致的文件时不再重复上传。"
            }
        }
    },
    "auth": {
        "type": "object",
        "description": "配置模式",
        "hint": "控制配置的生效范围。",
        "items": {
            "require_user_auth": {
                "description": "启用用户独立配置",
                "type": "bool",
                "default": false,
                "hint": "关闭：所有用户共享全局配置。开启：每个用户独立配置连接信息。"
            }
        }
    },
    "diagnostics": {
        "type": "object",
        "description": "诊断日志",
        "hint": "控制传输诊断日志的输出。",
        "items": {
            "debug_transfer_logging": {
                "description": "启用传输诊断日志",
                "type": "bool",
                "default": false,
                "hint": "开启后输出上传/下载进度、连接信息和 DNS 解析等详细日志。"
            },
            "upload_progress_step_mb": {
                "description": "进度日志间隔（MB）",
                "type": "int",
                "default": 64,
                "minimum": 1,
                "maximum": 1024,
                "hint": "上传时每传输指定 MB 记录一条进度日志（需开启传输诊断日志）。"
            }
        }
    }
}
